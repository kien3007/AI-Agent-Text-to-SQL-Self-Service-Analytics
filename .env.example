# ==============================================================================
# AI-Agent Text-to-SQL Self-Service Analytics - Environment Configuration
# Sao chép file này thành .env và điền các giá trị phù hợp với hạ tầng của bạn:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATA WAREHOUSE (DUCKDB IN-PROCESS OLAP ENGINE)
# ------------------------------------------------------------------------------
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/warehouse.duckdb

# ------------------------------------------------------------------------------
# 2. DUAL-MODEL LLM GATEWAY (Qwen 3 Reasoner + Qwen 2.5-Coder)
# Hỗ trợ OpenAI-compatible API: vLLM, Ollama, Together AI, OpenRouter, DeepSeek...
# Để trống LLM_BASE_URL nếu muốn chạy chế độ Mock Simulation / Rule-based
# ------------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=EMPTY
MODEL_REASONER=Qwen/Qwen2.5-72B-Instruct
MODEL_CODER=Qwen/Qwen2.5-Coder-32B-Instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# 3. SEMANTIC SEARCH & VECTOR STORE (LlamaIndex + Qdrant On-premise)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_STORAGE_DIR=./data/qdrant_db
VECTOR_DB_BACKEND=qdrant
# Token Hugging Face Hub (tùy chọn, giúp tải weights mô hình nhanh hơn và không bị giới hạn rate limit)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 4. FASTAPI WEB SERVER & NETWORKING
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. HUMAN-IN-THE-LOOP (HITL) GUARDRAIL THRESHOLDS
# Ngưỡng an toàn kích hoạt modal phê duyệt trước khi cho phép quét CSDL
# ------------------------------------------------------------------------------
HITL_SCAN_TABLETS_THRESHOLD=50
HITL_ROW_COUNT_THRESHOLD=1000000
HITL_ESTIMATED_BYTES_MB_THRESHOLD=500

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION (Enterprise RBAC)
# Tạo JWT_SECRET_KEY ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret-in-production
JWT_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 7. USER CREDENTIALS & QUERY BUDGET
# Thay đổi username/password trước khi deploy production!
# ------------------------------------------------------------------------------
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analyst123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DAILY_QUERY_BUDGET=100

# ------------------------------------------------------------------------------
# 8. SUPABASE AUTHENTICATION (Self-Hosted / Cloud)
# ------------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkwNzM3MTEwLCJleHAiOjIxMDYwOTcxMTB9._-tYI7PkRWAJmKEqr9V-i0U2JCIvzdlQKNOSG52XXJg
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTA3MzcxMTAsImV4cCI6MjEwNjA5NzExMH0.muw1teqhfApfDlJyfF0oSEh5XpHVeAkwNMYDBZe9NKM


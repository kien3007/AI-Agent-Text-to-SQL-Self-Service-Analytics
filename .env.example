# ==============================================================================
# AI-Agent Text-to-SQL Self-Service Analytics - Environment Configuration
# Sao chép file này thành .env và điền các giá trị phù hợp với hạ tầng của bạn:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CSDL APACHE DORIS (OLAP WAREHOUSE)
# ------------------------------------------------------------------------------
DORIS_HOST=localhost
DORIS_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=real_estate_analytics

# ------------------------------------------------------------------------------
# 2. DUAL-MODEL LLM GATEWAY (Qwen 3 Reasoner + Qwen 2.5-Coder)
# Hỗ trợ OpenAI-compatible API: vLLM, Ollama, Together AI, OpenRouter, DeepSeek...
# Để trống LLM_BASE_URL nếu muốn chạy chế độ Mock Simulation / Rule-based
# ------------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=EMPTY
MODEL_REASONER=Qwen/Qwen2.5-72B-Instruct
MODEL_CODER=Qwen/Qwen2.5-Coder-32B-Instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# 3. SEMANTIC SEARCH & VECTOR STORE (Bilingual BGE-M3 + ChromaDB)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./data/chroma_db
# Token Hugging Face Hub (tùy chọn, giúp tải weights mô hình nhanh hơn và không bị giới hạn rate limit)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 4. FASTAPI WEB SERVER & NETWORKING
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. HUMAN-IN-THE-LOOP (HITL) GUARDRAIL THRESHOLDS
# Ngưỡng an toàn kích hoạt modal phê duyệt trước khi cho phép quét CSDL
# ------------------------------------------------------------------------------
HITL_SCAN_TABLETS_THRESHOLD=50
HITL_ROW_COUNT_THRESHOLD=1000000
HITL_ESTIMATED_BYTES_MB_THRESHOLD=500
